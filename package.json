{
  "name": "dsh-link-menu",
  "version": "0.2.1",
  "description": "ChatGPT-like right-click menu for links and file references in DeepSeek Harness (DSH) desktop messages.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "context-menu",
    "right-click",
    "electron"
  ],
  "license": "MIT",
  "author": "肥鱼",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xchcy/DSH-Reflex.git"
  },
  "homepage": "https://github.com/Xchcy/DSH-Reflex#readme",
  "bugs": {
    "url": "https://github.com/Xchcy/DSH-Reflex/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/host-routes.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
