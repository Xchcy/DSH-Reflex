{
  "name": "dsh-link-menu",
  "version": "0.2.0",
  "description": "ChatGPT-like right-click menu for links and file references in DeepSeek Harness (DSH) desktop messages.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "context-menu",
    "right-click",
    "electron"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
